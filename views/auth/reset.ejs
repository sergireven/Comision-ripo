<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow center">
    <h1><%= t('Generar contraseña nueva') %></h1>
    <p><%= t('Cuenta') %>: <strong><%= account.email || account.username %></strong></p>
    <form method="post" action="/recuperar/<%= token %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn primary"><%= t('Generar contraseña nueva') %></button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
