<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow center">
    <h1>Generar contraseña nueva</h1>
    <p>Cuenta: <strong><%= account.player_name || account.username %></strong> (<%= account.dni || account.username %>)</p>
    <form method="post" action="/recuperar/<%= token %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn primary">Generar contraseña nueva</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
