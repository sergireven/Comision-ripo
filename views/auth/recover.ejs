<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow">
    <h1><%= t('Recuperar acceso') %></h1>
    <% if (typeof sent !== 'undefined') { %>
      <div class="flash ok"><%= t('Si hay una cuenta con ese correo, te hemos enviado un enlace para generar una contraseña nueva. Revisa también la carpeta de spam.') %></div>
      <p class="muted"><%= t('¿No te llega? Habla con la comisión.') %></p>
    <% } else { %>
      <% if (typeof error !== 'undefined') { %><div class="flash error"><%= t(error) %></div><% } %>
      <p><%= t('Te enviaremos un enlace al correo de tu cuenta para generar una contraseña nueva.') %></p>
      <form method="post" action="/recuperar" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label><%= t('Correo electrónico') %>
          <input name="usuario" inputmode="email" autocapitalize="none" required autofocus>
        </label>
        <button class="btn primary block"><%= t('Enviar enlace') %></button>
      </form>
    <% } %>
    <p class="center"><a href="/login"><%= t('Volver a entrar') %></a></p>
  </div>
</section>
<%- include('../partials/footer') %>
