<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow">
    <h1><%= t('Entrar a la botiga') %></h1>
    <% if (typeof error !== 'undefined') { %><div class="flash error"><%= t(error) %></div><% } %>
    <form method="post" action="/login" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%= t('Correo electrónico') %>
        <input name="usuario" value="<%= usuario %>" autocomplete="username" inputmode="email" autocapitalize="none" required autofocus>
      </label>
      <label><%= t('Contraseña') %>
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="btn primary block"><%= t('Entrar') %></button>
    </form>
    <div class="auth-links">
      <a href="/registro" class="btn ghost block"><%= t('¿No tienes cuenta? Créala con tu correo') %></a>
      <a href="/recuperar"><%= t('He olvidado mi contraseña') %></a>
    </div>
    <p class="hint center"><%= t('Comisión: entra con tu usuario.') %></p>
  </div>
</section>
<%- include('../partials/footer') %>
