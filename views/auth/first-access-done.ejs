<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow center">
    <h1><%= typeof reset !== 'undefined' ? t('Contraseña nueva') : t('¡Cuenta creada!') %></h1>
    <p><%= t('Esta es tu contraseña. Apúntala: la necesitarás para volver a entrar.') %></p>
    <div class="secret"><%= password %></div>
    <p class="muted"><%= t('Usuario') %>: <strong><%= user.email || user.username %></strong><br>
      <% if (mailEnabled) { %><%= t('También te la hemos enviado a') %> <strong><%= email %></strong>.<br><% } %>
      <%= t('Puedes cambiarla cuando quieras en «Mi cuenta».') %></p>
    <a class="btn primary" href="<%= user.role === 'admin' ? '/admin' : '/tienda' %>"><%= user.role === 'admin' ? t('Ir al panel') : t('Ir a la tienda') %></a>
  </div>
</section>
<%- include('../partials/footer') %>
