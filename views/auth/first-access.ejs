<%- include('../partials/header') %>
<section class="auth">
  <div class="card narrow">
    <h1><%= t('Primer acceso') %></h1>
    <ol class="steps"><li class="<%= step === 1 ? 'current' : 'done' %>">DNI</li><li class="<%= step === 2 ? 'current' : '' %>"><%= t('Correo') %></li><li><%= t('Contraseña') %></li></ol>
    <% if (typeof error !== 'undefined') { %><div class="flash error"><%= t(error) %></div><% } %>
    <form method="post" action="/primer-acceso" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if (step === 1) { %>
        <p><%= t('Introduce el DNI de tu hijo/a tal como lo tiene registrado el club.') %></p>
        <label><%= t('DNI del jugador/a') %>
          <input name="dni" value="<%= dni %>" autocapitalize="characters" required autofocus>
        </label>
        <button class="btn primary block"><%= t('Continuar') %></button>
      <% } else { %>
        <input type="hidden" name="dni" value="<%= dni %>">
        <input type="hidden" name="step" value="2">
        <p><%= t('Cuenta de') %> <strong><%= playerName %></strong> (<%= dni %>).</p>
        <p class="muted"><%= t('Indica el correo de contacto. Allí recibirás la contraseña y los avisos de tus pedidos.') %></p>
        <label><%= t('Correo electrónico') %>
          <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" autocomplete="email" required autofocus>
        </label>
        <label><%= t('Repite el correo') %>
          <input type="email" name="email2" autocomplete="off" required>
        </label>
        <button class="btn primary block"><%= t('Activar cuenta y generar contraseña') %></button>
      <% } %>
    </form>
    <p class="center"><a href="/login"><%= t('Volver a entrar') %></a></p>
  </div>
</section>
<%- include('../partials/footer') %>
