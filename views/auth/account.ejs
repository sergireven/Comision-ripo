<%- include('../partials/header') %>
<h1><%= t('Mi cuenta') %></h1>
<div class="grid two">
  <section class="card">
    <h2><%= t('Datos') %></h2>
    <dl class="kv">
      <% if (user.role === 'family') { %>
        <dt><%= t('Usuario') %></dt><dd><%= user.email %></dd>
      <% } else { %>
        <dt><%= t('Usuario') %></dt><dd><%= user.username %></dd>
      <% } %>
      <dt><%= t('Idioma') %></dt><dd><a href="/idioma/ca">Català</a> · <a href="/idioma/es">Castellano</a></dd>
    </dl>
    <% if (user.role === 'family') { %>
      <form method="post" action="/cuenta/nombre" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label><%= t('Nombre y apellidos') %>
          <input name="name" value="<%= user.player_name || '' %>" autocomplete="name" maxlength="80" required>
        </label>
        <button class="btn"><%= t('Guardar nombre') %></button>
      </form>
    <% } %>
    <form method="post" action="/cuenta/email" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%= user.role === 'family' ? t('Correo (es también tu usuario)') : t('Correo de contacto') %>
        <input type="email" name="email" value="<%= user.email || '' %>" required>
      </label>
      <button class="btn"><%= t('Guardar correo') %></button>
    </form>
  </section>
  <section class="card">
    <h2><%= t('Cambiar contraseña') %></h2>
    <form method="post" action="/cuenta/password" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%= t('Contraseña actual') %> <input type="password" name="current" autocomplete="current-password" required></label>
      <label><%= t('Nueva contraseña (mín. 8)') %> <input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
      <label><%= t('Repite la nueva') %> <input type="password" name="password2" autocomplete="new-password" minlength="8" required></label>
      <button class="btn"><%= t('Cambiar contraseña') %></button>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>
