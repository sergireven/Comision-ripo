<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= t('Productos') %></h1>
  <div class="row"><a class="btn ghost" href="/admin/categorias"><%= t('Categorías') %></a><a class="btn primary" href="/admin/productos/nuevo">+ <%= t('Nuevo producto') %></a></div>
</div>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th></th><th><%= t('Producto') %></th><th><%= t('Categoría') %></th><th class="num"><%= t('Precio') %></th><th><%= t('Colores') %> / <%= t('Tallas') %></th><th><%= t('Nombre + número') %></th><th><%= t('Visible') %></th></tr></thead>
    <tbody>
    <% list.forEach(p => { %>
      <tr class="<%= p.active ? '' : 'unavailable' %>">
        <td><% if (p.image) { %><img class="thumb" src="/uploads/<%= p.image %>" alt=""><% } %></td>
        <td><a href="/admin/productos/<%= p.id %>"><strong><%= loc(p, 'name') %></strong></a></td>
        <td><%= lang === 'ca' && p.category_ca ? p.category_ca : (p.category || '—') %></td>
        <td class="num"><%= formatMoney(p.price_cents) %></td>
        <td class="small"><%= [p.colors, p.sizes].filter(Boolean).join(' · ') || '—' %></td>
        <td><%= p.personalization ? t('Sí') : t('No') %></td>
        <td><%= p.active ? t('Sí') : t('Oculto') %></td>
      </tr>
    <% }) %>
    <% if (!list.length) { %><tr><td colspan="7" class="center muted"><%= t('Aún no hay productos. Crea el primero.') %></td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
