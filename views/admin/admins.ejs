<%- include('../partials/header') %>
<h1><%= t('Comisión (administradores)') %></h1>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Usuario') %></th><th><%= t('Nombre') %></th><th><%= t('Correo') %></th><th></th></tr></thead>
    <tbody>
    <% list.forEach(a => { %>
      <tr><td><strong><%= a.username %></strong></td><td><%= a.player_name %></td><td><%= a.email || '—' %></td>
        <td><% if (a.id !== user.id) { %>
          <form method="post" action="/admin/admins/<%= a.id %>/eliminar" data-confirm="<%= t('¿Eliminar a {name}?', { name: a.username }) %>">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger ghost"><%= t('Eliminar') %></button>
          </form><% } %></td></tr>
    <% }) %>
    </tbody>
  </table>
</div>
<form method="post" action="/admin/admins" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2><%= t('Añadir miembro de la comisión') %></h2>
  <div class="row wrap-row">
    <label class="grow"><%= t('Usuario') %> <input name="username" required pattern="[a-zA-Z0-9._\-]{3,30}"></label>
    <label class="grow"><%= t('Nombre') %> <input name="name"></label>
  </div>
  <div class="row wrap-row">
    <label class="grow"><%= t('Correo') %> <input type="email" name="email"></label>
    <label class="grow"><%= t('Contraseña (mín. 10)') %> <input type="password" name="password" minlength="10" required autocomplete="new-password"></label>
  </div>
  <button class="btn primary"><%= t('Crear') %></button>
</form>
<%- include('../partials/footer') %>
