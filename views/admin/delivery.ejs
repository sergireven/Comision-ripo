<%- include('../partials/header') %>
<section class="card narrow">
  <div class="page-head">
    <h1>Pedido <%= orderCode(order.id) %></h1>
    <%- include('../partials/status', { status: order.status }) %>
  </div>
  <p class="big-name"><%= family.player_name %> <span class="muted"><%= family.dni %><%= family.team ? ' · ' + family.team : '' %></span></p>
  <ul class="items">
    <% items.forEach(it => { %>
      <li><strong><%= it.quantity %> ×</strong> <%= it.product_name %>
        <%= it.size ? ' · talla ' + it.size : '' %><%= it.custom_name ? ' · «' + it.custom_name + '» #' + it.custom_number : '' %></li>
    <% }) %>
  </ul>
  <p>Total: <strong><%= formatMoney(order.total_cents) %></strong></p>

  <% if (order.status === 'pendiente_entrega') { %>
    <div class="flash ok">Pagado el <%= formatDate(order.paid_at) %>. Comprueba el material con la familia y confirma.</div>
    <form method="post" action="/admin/entrega/<%= order.qr_token %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn primary block big">✔ Confirmar entrega</button>
    </form>
  <% } else if (order.status === 'pendiente_pago') { %>
    <div class="flash error">Este pedido <strong>todavía no está pagado</strong>. No se puede entregar.</div>
    <a class="btn" href="/admin/pedidos/<%= order.id %>">Ir al pedido para registrar el pago</a>
  <% } else if (order.status === 'entregado') { %>
    <div class="flash ok">Ya se entregó el <%= formatDate(order.delivered_at) %>.</div>
  <% } else { %>
    <div class="flash error">Este pedido está cancelado.</div>
  <% } %>
  <p class="center"><a href="/admin/entrega">Entregar otro pedido</a> · <a href="/admin/pedidos/<%= order.id %>">Ver detalle</a></p>
</section>
<%- include('../partials/footer') %>
