<%- include('../partials/header') %>
<div class="page-head">
  <h1>Pedidos</h1>
  <a class="btn" href="/admin/pedidos.csv?<%= new URLSearchParams(Object.entries(q).filter(([k, v]) => typeof v === 'string')).toString() %>">Descargar Excel (CSV)</a>
</div>
<form method="get" class="card filters">
  <label>Estado
    <select name="estado" data-autosubmit>
      <option value="">Todos</option>
      <% Object.entries(STATUS).forEach(([k, s]) => { %><option value="<%= k %>" <%= q.estado === k ? 'selected' : '' %>><%= s.label %></option><% }) %>
    </select>
  </label>
  <label>Periodo
    <select name="periodo" data-autosubmit>
      <option value="">Todos</option>
      <% periods.forEach(p => { %><option value="<%= p.id %>" <%= String(q.periodo) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
    </select>
  </label>
  <label class="grow">Buscar
    <input name="q" value="<%= q.q || '' %>" placeholder="Nombre, DNI, correo, nº pedido o código">
  </label>
  <button class="btn">Filtrar</button>
</form>

<p class="muted"><%= list.length %> pedido(s) · total <strong><%= formatMoney(total) %></strong></p>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th>Pedido</th><th>Jugador/a</th><th>Fecha</th><th>Art.</th><th class="num">Importe</th><th>Estado</th><th>Acción rápida</th></tr></thead>
    <tbody>
    <% list.forEach(o => { %>
      <tr>
        <td><a href="/admin/pedidos/<%= o.id %>"><strong><%= orderCode(o.id) %></strong></a></td>
        <td><%= o.player_name %><br><span class="muted small"><%= o.dni %><%= o.player_number ? ' · #' + o.player_number : '' %></span></td>
        <td class="small"><%= formatDate(o.created_at) %></td>
        <td><%= o.units %></td>
        <td class="num"><%= formatMoney(o.total_cents) %></td>
        <td><%- include('../partials/status', { status: o.status }) %></td>
        <td>
          <% if (o.status === 'pendiente_pago') { %>
            <form method="post" action="/admin/pedidos/<%= o.id %>/estado" data-confirm="¿Has cobrado <%= formatMoney(o.total_cents) %> de <%= o.player_name %>?">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="status" value="pendiente_entrega">
              <input type="hidden" name="back" value="list">
              <button class="btn small primary">Marcar pagado</button>
            </form>
          <% } else { %>
            <a class="btn small ghost" href="/admin/pedidos/<%= o.id %>">Ver</a>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!list.length) { %><tr><td colspan="7" class="center muted">No hay pedidos con estos filtros.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
