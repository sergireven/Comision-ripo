<%- include('../partials/header') %>
<p><a href="/admin/productos">← <%= t('Productos') %></a></p>
<h1><%= t('Categorías') %></h1>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Nombre (castellano)') %> · <%= t('Nombre (catalán)') %> · <%= t('Orden') %></th><th><%= t('Productos') %></th><th></th></tr></thead>
    <tbody>
    <% list.forEach(c => { %>
      <tr>
        <td>
          <form method="post" action="/admin/categorias/<%= c.id %>" class="row tight wrap-row">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input name="name" value="<%= c.name %>" class="grow" required aria-label="<%= t('Nombre (castellano)') %>">
            <input name="name_ca" value="<%= c.name_ca || '' %>" class="grow" aria-label="<%= t('Nombre (catalán)') %>" placeholder="<%= t('Nombre (catalán)') %>">
            <input type="number" name="sort_order" value="<%= c.sort_order %>" class="qty" aria-label="<%= t('Orden') %>">
            <button class="btn small"><%= t('Guardar') %></button>
          </form>
        </td>
        <td><%= c.products %></td>
        <td>
          <form method="post" action="/admin/categorias/<%= c.id %>/eliminar" data-confirm="<%= t('¿Eliminar la categoría «{name}»?', { name: c.name }) %>">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn small danger ghost"><%= t('Eliminar') %></button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<form method="post" action="/admin/categorias" class="card row wrap-row">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input name="name" class="grow" placeholder="<%= t('Nueva categoría (ej.: Gorras)') %>" required>
  <input name="name_ca" class="grow" placeholder="<%= t('En catalán (ej.: Gorres)') %>">
  <button class="btn primary"><%= t('Añadir') %></button>
</form>
<%- include('../partials/footer') %>
