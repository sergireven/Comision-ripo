<%- include('../partials/header') %>
<p><a href="/admin/productos">← <%= t('Productos') %></a></p>
<h1><%= t(title) %></h1>
<% if (typeof error !== 'undefined') { %><div class="flash error"><%= t(error) %></div><% } %>
<form method="post" enctype="multipart/form-data" class="card form"
      action="/admin/productos<%= product.id ? '/' + product.id : '' %>?_csrf=<%= csrf %>">
  <div class="grid two">
    <div>
      <div class="row wrap-row">
        <label class="grow"><%= t('Nombre (castellano)') %> <input name="name" value="<%= product.name || '' %>" maxlength="100" required></label>
        <label class="grow"><%= t('Nombre (catalán)') %> <input name="name_ca" value="<%= product.name_ca || '' %>" maxlength="100" placeholder="<%= t('Opcional') %>"></label>
      </div>
      <label><%= t('Categoría') %>
        <select name="category_id">
          <option value="">— <%= t('Sin categoría') %> —</option>
          <% categories.forEach(c => { %><option value="<%= c.id %>" <%= product.category_id === c.id ? 'selected' : '' %>><%= loc(c, 'name') %></option><% }) %>
        </select>
      </label>
      <label><%= t('Precio (€)') %> <input name="price" inputmode="decimal" value="<%= product.price_cents != null ? (product.price_cents / 100).toFixed(2).replace('.', ',') : '' %>" placeholder="25,00" required></label>
      <label><%= t('Tallas (separadas por comas, vacío si no tiene)') %>
        <input name="sizes" value="<%= product.sizes || '' %>" placeholder="6, 8, 10, 12, 14, S, M, L, XL">
      </label>
      <label><%= t('Colores (separados por comas, la familia elige uno)') %>
        <input name="colors" value="<%= product.colors || '' %>" placeholder="<%= t('Ej.: Amarillo, Azul marino, Negro') %>">
      </label>
      <label><%= t('Modelos (separados por comas, la familia elige uno)') %>
        <input name="options" value="<%= product.options || '' %>" placeholder="<%= t('Ej.: Escudo, Pollito') %>">
      </label>
      <label><%= t('Descripción (castellano)') %> <textarea name="description" rows="2" maxlength="1000"><%= product.description || '' %></textarea></label>
      <label><%= t('Descripción (catalán)') %> <textarea name="description_ca" rows="2" maxlength="1000" placeholder="<%= t('Opcional') %>"><%= product.description_ca || '' %></textarea></label>
      <label class="check"><input type="checkbox" name="personalization" value="1" <%= product.personalization ? 'checked' : '' %>> <%= t('Requiere nombre jugador + dorsal') %></label>
      <label class="check"><input type="checkbox" name="active" value="1" <%= product.active ? 'checked' : '' %>> <%= t('Visible en la tienda') %></label>
    </div>
    <div>
      <label><%= t('Foto (JPG, PNG o WEBP, máx. 5 MB)') %>
        <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" data-preview="#preview">
      </label>
      <img id="preview" class="preview" src="<%= product.image ? '/uploads/' + product.image : '' %>" alt="" <%= product.image ? '' : 'hidden' %>>
      <% if (product.image) { %><label class="check"><input type="checkbox" name="remove_image" value="1"> <%= t('Quitar foto') %></label><% } %>
      <hr>
      <label><%= t('Guía de tallas (imagen, opcional)') %>
        <input type="file" name="size_guide" accept="image/jpeg,image/png,image/webp,image/gif" data-preview="#preview-guide">
      </label>
      <img id="preview-guide" class="preview" src="<%= product.size_guide ? '/uploads/' + product.size_guide : '' %>" alt="" <%= product.size_guide ? '' : 'hidden' %>>
      <% if (product.size_guide) { %><label class="check"><input type="checkbox" name="remove_size_guide" value="1"> <%= t('Quitar guía de tallas') %></label><% } %>
    </div>
  </div>
  <button class="btn primary"><%= t('Guardar') %></button>
</form>
<% if (product.id) { %>
  <form method="post" action="/admin/productos/<%= product.id %>/eliminar" data-confirm="<%= t('¿Eliminar este producto? Los pedidos ya hechos no se ven afectados. (Si solo quieres ocultarlo, desmarca «Visible».)') %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn danger ghost small"><%= t('Eliminar producto') %></button>
  </form>
<% } %>
<%- include('../partials/footer') %>
