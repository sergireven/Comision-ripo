<%- include('../partials/header') %>
<p><a href="/admin/familias">← <%= t('Familias') %></a></p>
<h1><%= family.player_name %></h1>
<div class="grid two">
  <form method="post" action="/admin/familias/<%= family.id %>" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2><%= t('Datos') %></h2>
    <label>DNI <input name="dni" value="<%= family.dni %>" required></label>
    <label><%= t('Nombre y apellidos') %> <input name="player_name" value="<%= family.player_name %>" required></label>
    <div class="row">
      <label><%= t('Dorsal') %> <input name="player_number" value="<%= family.player_number || '' %>" class="qty"></label>
      <label class="grow"><%= t('Equipo') %> <input name="team" value="<%= family.team || '' %>"></label>
    </div>
    <label><%= t('Correo de contacto') %> <input type="email" name="email" value="<%= family.email || '' %>"></label>
    <button class="btn primary"><%= t('Guardar') %></button>
  </form>
  <section class="card">
    <h2><%= t('Acceso') %></h2>
    <% if (family.activated_at) { %>
      <p><%= t('Cuenta activada el {date}.', { date: formatDate(family.activated_at) }) %></p>
    <% } else { %>
      <p><%= t('La familia aún no ha hecho el primer acceso.') %></p>
    <% } %>
    <form method="post" action="/admin/familias/<%= family.id %>/enviar-acceso" class="form"
          data-confirm="<%= family.activated_at ? t('Se generará una contraseña nueva y la actual dejará de funcionar. ¿Continuar?') : t('¿Enviar la contraseña por correo?') %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%= t('Enviar acceso por correo a') %>
        <input type="email" name="email" value="<%= family.email || '' %>" required>
      </label>
      <button class="btn"><%= family.activated_at ? t('Enviar contraseña nueva') : t('Activar y enviar contraseña') %></button>
    </form>
    <form method="post" action="/admin/familias/<%= family.id %>/reiniciar" data-confirm="<%= t('Se borrará la contraseña y el correo y la familia tendrá que volver a hacer el «Primer acceso». ¿Continuar?') %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn ghost"><%= t('Reiniciar acceso') %></button>
    </form>
    <p class="hint"><%= t('Útil si la familia ha perdido el acceso a su correo o si alguien activó la cuenta por error.') %></p>
    <% if (!list.length) { %>
      <form method="post" action="/admin/familias/<%= family.id %>/eliminar" data-confirm="<%= t('¿Eliminar a {name}?', { name: family.player_name }) %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn danger ghost small"><%= t('Eliminar') %></button>
      </form>
    <% } %>
  </section>
</div>
<h2><%= t('Pedidos') %></h2>
<div class="order-list">
  <% list.forEach(o => { %>
    <a class="card order-row" href="/admin/pedidos/<%= o.id %>">
      <div><strong><%= orderCode(o.id) %></strong><br><span class="muted small"><%= formatDate(o.created_at) %></span></div>
      <div class="right"><%- include('../partials/status', { status: o.status }) %><br><strong><%= formatMoney(o.total_cents) %></strong></div>
    </a>
  <% }) %>
  <% if (!list.length) { %><p class="muted"><%= t('Sin pedidos.') %></p><% } %>
</div>
<%- include('../partials/footer') %>
