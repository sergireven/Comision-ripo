<%- include('../partials/header') %>
<p><a href="/admin/pedidos">← <%= t('Pedidos') %></a></p>
<div class="page-head">
  <h1><%= t('Pedido {code}', { code: orderCode(order.id) }) %></h1>
  <%- include('../partials/status', { status: order.status }) %>
</div>

<div class="grid two">
  <section class="card">
    <h2><%= t('Familia') %></h2>
    <dl class="kv">
      <dt><%= t('Jugador/a') %></dt><dd><a href="/admin/familias/<%= family.id %>"><%= family.player_name %></a></dd>
      <dt>DNI</dt><dd><%= family.dni %></dd>
      <% if (family.player_number) { %><dt><%= t('Dorsal') %></dt><dd><%= family.player_number %></dd><% } %>
      <% if (family.team) { %><dt><%= t('Equipo') %></dt><dd><%= family.team %></dd><% } %>
      <dt><%= t('Correo') %></dt><dd><%= family.email || '—' %></dd>
      <dt><%= t('Pedido el') %></dt><dd><%= formatDate(order.created_at) %></dd>
      <% if (order.paid_at) { %><dt><%= t('Pagado el') %></dt><dd><%= formatDate(order.paid_at) %><%= paidBy ? ' · ' + paidBy : '' %></dd><% } %>
      <% if (order.ready_at) { %><dt><%= t('Aviso de recogida') %></dt><dd><%= formatDate(order.ready_at) %></dd><% } %>
      <% if (order.delivered_at) { %><dt><%= t('Entregado el') %></dt><dd><%= formatDate(order.delivered_at) %><%= deliveredBy ? ' · ' + deliveredBy : '' %></dd><% } %>
    </dl>
  </section>

  <section class="card">
    <h2><%= t('Acciones') %></h2>
    <% if (order.status === 'pendiente_pago') { %>
      <form method="post" action="/admin/pedidos/<%= order.id %>/estado" class="form" data-confirm="<%= t('¿Has recibido {amount} en mano?', { amount: formatMoney(order.total_cents) }) %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="pendiente_entrega">
        <button class="btn primary block big"><%= t('Cobrado {amount}', { amount: formatMoney(order.total_cents) }) %></button>
        <p class="hint"><%= t('Lo más rápido es escanear el QR de pago de la familia.') %></p>
      </form>
    <% } %>
    <% if (order.status === 'pendiente_entrega') { %>
      <form method="post" action="/admin/pedidos/<%= order.id %>/estado" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="entregado">
        <label><%= t('Código de recogida que enseña la familia') %>
          <input name="code" autocapitalize="characters" maxlength="6" placeholder="K7QM3X" required>
        </label>
        <button class="btn primary block"><%= t('Confirmar entrega') %></button>
        <p class="hint"><%= t('O escanea su QR de recogida.') %></p>
      </form>
      <details class="small">
        <summary><%= t('La familia no tiene el QR ni el código') %></summary>
        <form method="post" action="/admin/pedidos/<%= order.id %>/estado" class="form" data-confirm="<%= t('¿Marcar como entregado sin código? Quedará registrado.') %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="status" value="entregado">
          <input type="hidden" name="force" value="1">
          <label><%= t('Motivo / quién lo recoge') %> <input name="note" maxlength="300" required></label>
          <button class="btn ghost"><%= t('Marcar entregado sin código') %></button>
        </form>
      </details>
    <% } %>

    <% const other = transitions.filter(s => !(order.status === 'pendiente_pago' && s === 'pendiente_entrega') && s !== 'entregado'); %>
    <% if (other.length) { %>
      <h3><%= t('Otros cambios') %></h3>
      <div class="row wrap-row">
      <% other.forEach(s => { %>
        <form method="post" action="/admin/pedidos/<%= order.id %>/estado" data-confirm="<%= t('¿Cambiar a «{status}»? Se avisará por correo a la familia.', { status: statusLabel(s) }) %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="status" value="<%= s %>">
          <button class="btn small <%= s === 'cancelado' ? 'danger ghost' : 'ghost' %>">
            <%= s === 'cancelado' ? t('Cancelar pedido') : s === 'pendiente_pago' ? (order.status === 'cancelado' ? t('Reactivar (pendiente de pago)') : t('Deshacer pago')) : t('Deshacer entrega') %>
          </button>
        </form>
      <% }) %>
      </div>
    <% } %>
  </section>
</div>

<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Producto') %></th><th><%= t('Talla') %></th><th><%= t('Nombre jugador') %></th><th><%= t('Dorsal') %></th><th><%= t('Cant.') %></th><th class="num"><%= t('Importe') %></th></tr></thead>
    <tbody>
    <% items.forEach(it => { %>
      <tr><td><%- include('../partials/line-name', { it }) %><% if (it.color || it.option_value) { %><br><span class="muted small"><%= [it.color, it.option_value].filter(Boolean).join(' · ') %></span><% } %></td><td><%= it.size || '—' %></td><td><%= it.custom_name || '—' %></td><td><%= it.custom_number || '—' %></td>
        <td><%= it.quantity %></td><td class="num"><%= formatMoney(it.unit_price_cents * it.quantity) %></td></tr>
    <% }) %>
    </tbody>
    <tfoot><tr><th colspan="5"><%= t('Total') %></th><th class="num"><%= formatMoney(order.total_cents) %></th></tr></tfoot>
  </table>
</div>

<div class="card">
  <h2><%= t('Historial') %></h2>
  <ul class="timeline">
    <% events.forEach(e => { const parts = (e.note || '').split(': '); %>
      <li><span class="muted small"><%= formatDate(e.created_at) %></span> <%- include('../partials/status', { status: e.status }) %>
        <span class="small"><%= t('por') %> <%= e.role === 'admin' ? e.username : e.role === 'family' ? t('la familia') : '—' %></span>
        <% if (e.note) { %><span class="small muted"> · <%= t(parts[0]) %><%= parts.length > 1 ? ': ' + parts.slice(1).join(': ') : '' %></span><% } %></li>
    <% }) %>
  </ul>
</div>
<%- include('../partials/footer') %>
