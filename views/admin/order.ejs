<%- include('../partials/header') %>
<p><a href="/admin/pedidos">← <%= t('Pedidos') %></a></p>
<div class="page-head">
  <h1><%= t('Pedido {code}', { code: orderCode(order.id) }) %></h1>
  <%- include('../partials/status', { status: order.status, partial: order.partial_at }) %>
</div>
<% const showDelivery = !!order.partial_at && ['pendiente_entrega', 'entregado'].includes(order.status);
   const physical = items.filter((i) => i.kind !== 'pack'); %>

<div class="grid two">
  <section class="card">
    <h2><%= t('Cliente') %></h2>
    <dl class="kv">
      <dt><%= t('Correo') %></dt><dd><a href="/admin/clientes/<%= family.id %>"><%= customerLabel(family) %></a></dd>
      <dt><%= t('Pedido el') %></dt><dd><%= formatDate(order.created_at) %></dd>
      <% if (order.paid_at) { %><dt><%= t('Pagado el') %></dt><dd><%= formatDate(order.paid_at) %><%= paidBy ? ' · ' + paidBy : '' %></dd><% } %>
      <% if (order.ready_at) { %><dt><%= t('Aviso de recogida') %></dt><dd><%= formatDate(order.ready_at) %></dd><% } %>
      <% if (order.delivered_at) { %><dt><%= t('Entregado el') %></dt><dd><%= formatDate(order.delivered_at) %><%= deliveredBy ? ' · ' + deliveredBy : '' %></dd><% } %>
    </dl>
  </section>

  <section class="card">
    <h2><%= t('Acciones') %></h2>
    <% if (order.status === 'pendiente_pago') { %>
      <form method="post" action="/admin/pedidos/<%= order.id %>/estado" class="form" data-confirm="<%= t('¿Has recibido {amount} en mano?', { amount: formatMoney(order.total_cents) }) %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="pendiente_entrega">
        <button class="btn primary block big"><%= t('Cobrado {amount}', { amount: formatMoney(order.total_cents) }) %></button>
        <p class="hint"><%= t('Lo más rápido es escanear el QR del pedido.') %></p>
      </form>
    <% } %>
    <% if (order.status === 'pendiente_entrega') { %>
      <form method="post" action="/admin/pedidos/<%= order.id %>/estado" class="form" data-confirm="<%= t('¿Marcar el pedido {code} como entregado?', { code: orderCode(order.id) }) %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="entregado">
        <button class="btn primary block big">✔ <%= t('Marcar entregado') %></button>
        <p class="hint"><%= t('También puedes escanear el QR del pedido.') %></p>
      </form>
      <a class="btn block" href="#entrega-parcial"><%= t('Entrega parcial…') %></a>
    <% } %>

    <% const other = transitions.filter(s => !(order.status === 'pendiente_pago' && s === 'pendiente_entrega') && s !== 'entregado'); %>
    <% if (other.length) { %>
      <h3><%= t('Otros cambios') %></h3>
      <div class="row wrap-row">
      <% other.forEach(s => { %>
        <form method="post" action="/admin/pedidos/<%= order.id %>/estado" data-confirm="<%= t('¿Cambiar a «{status}»? Se avisará por correo a la familia.', { status: statusLabel(s) }) %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="status" value="<%= s %>">
          <button class="btn small <%= s === 'cancelado' ? 'danger ghost' : 'ghost' %>">
            <%= s === 'cancelado' ? t('Cancelar pedido') : s === 'pendiente_pago' ? (order.status === 'cancelado' ? t('Reactivar (pendiente de pago)') : t('Deshacer pago')) : t('Deshacer entrega') %>
          </button>
        </form>
      <% }) %>
      </div>
    <% } %>
    <form method="post" action="/admin/pedidos/<%= order.id %>/eliminar" class="form"
          data-confirm="<%= t('¿Eliminar el pedido {code} para siempre? No se puede deshacer.', { code: orderCode(order.id) }) %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn small danger"><%= t('Eliminar pedido') %></button>
      <p class="hint"><%= t('Para borrar pedidos de prueba. Desaparece de las listas, la caja y el resumen. Al borrar el último, la numeración vuelve a empezar por el #0001.') %></p>
    </form>
  </section>
</div>

<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Producto') %></th><th><%= t('Talla') %></th><th><%= t('Nombre jugador') %></th><th><%= t('Dorsal') %></th><th><%= t('Cant.') %></th><% if (showDelivery) { %><th><%= t('Entrega') %></th><% } %><th class="num"><%= t('Importe') %></th></tr></thead>
    <tbody>
    <% items.forEach(it => { %>
      <tr><td><%- include('../partials/line-name', { it }) %><% if (it.color || it.option_value) { %><br><span class="muted small"><%= [it.color, it.option_value].filter(Boolean).join(' · ') %></span><% } %></td><td><%= it.size || '—' %></td><td><%= it.custom_name || (it.no_custom ? t('Sin personalizar') : '—') %></td><td><%= it.custom_number || '—' %></td>
        <td><%= it.quantity %></td><% if (showDelivery) { %><td data-label="<%= t('Entrega') %>"><% if (it.kind === 'pack') { %><% } else if (order.status === 'entregado' || it.delivered_qty >= it.quantity) { %><span class="delivered-yes">✔ <%= t('Ya entregado') %></span><% } else if (it.delivered_qty > 0) { %><span class="delivered-part"><%= t('{n} de {total}', { n: it.delivered_qty, total: it.quantity }) %></span><% } else { %><span class="delivered-no"><%= t('Falta') %></span><% } %></td><% } %><td class="num"><%= formatMoney(it.unit_price_cents * it.quantity) %></td></tr>
    <% }) %>
    </tbody>
    <tfoot><tr><th colspan="<%= showDelivery ? 6 : 5 %>"><%= t('Total') %></th><th class="num"><%= formatMoney(order.total_cents) %></th></tr></tfoot>
  </table>
</div>

<% if (order.status === 'pendiente_entrega') { %>
<form method="post" action="/admin/pedidos/<%= order.id %>/parcial" class="card form" id="entrega-parcial">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2><%= t('Entrega parcial') %></h2>
  <p class="hint"><%= t('Solo si falta material: marca lo que se entrega ahora. El pedido quedará como «Entregado parcialmente» y cuando llegue el resto se escanea el QR como siempre.') %></p>
  <ul class="partial-list">
    <% physical.forEach(it => { %>
      <li>
        <span><%- include('../partials/line-name', { it }) %><br><span class="muted small"><%- include('../partials/items', { it }) %></span></span>
        <% if (it.quantity === 1) { %>
          <label class="partial-check"><input type="hidden" name="qty_<%= it.id %>" value="0"><input type="checkbox" name="qty_<%= it.id %>" value="1" <%= it.delivered_qty >= 1 ? 'checked' : '' %>> <%= t('Ya entregado') %></label>
        <% } else { %>
          <label class="partial-check"><%= t('Entregadas') %>
            <select name="qty_<%= it.id %>"><% for (let n = 0; n <= it.quantity; n++) { %><option value="<%= n %>" <%= it.delivered_qty === n ? 'selected' : '' %>><%= n %></option><% } %></select>
            <%= t('de {total}', { total: it.quantity }) %></label>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <button class="btn primary"><%= t('Guardar entrega parcial') %></button>
</form>
<% } %>

<div class="card">
  <h2><%= t('Historial') %></h2>
  <ul class="timeline">
    <% events.forEach(e => { const parts = (e.note || '').split(': '); %>
      <li><span class="muted small"><%= formatDate(e.created_at) %></span> <%- include('../partials/status', { status: e.status }) %>
        <span class="small"><%= t('por') %> <%= e.role === 'admin' ? e.username : e.role === 'family' ? t('la familia') : '—' %></span>
        <% if (e.note) { %><span class="small muted"> · <%= t(parts[0]) %><%= parts.length > 1 ? ': ' + parts.slice(1).join(': ') : '' %></span><% } %></li>
    <% }) %>
  </ul>
</div>
<%- include('../partials/footer') %>
