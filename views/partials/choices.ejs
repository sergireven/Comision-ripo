<%# Campos que elige la familia para un producto: color, opción, talla y nombre + dorsal.
    `suffix` distingue los productos dentro de un pack (size_12, color_12…); vacío para un producto suelto. %>
<% const sizes = parseSizes(p.sizes), colors = parseSizes(p.colors), options = parseSizes(p.options); %>
<% if (colors.length > 1) { %>
  <label><%= t('Color') %>
    <select name="color<%= suffix %>" required>
      <option value=""><%= t('Elige…') %></option>
      <% colors.forEach(c => { %><option><%= c %></option><% }) %>
    </select>
  </label>
<% } %>
<% if (options.length > 1) { %>
  <label><%= t('Modelo') %>
    <select name="option_value<%= suffix %>" required>
      <option value=""><%= t('Elige…') %></option>
      <% options.forEach(o => { %><option><%= o %></option><% }) %>
    </select>
  </label>
<% } %>
<% if (sizes.length) { %>
  <label><%= t('Talla') %>
    <% if (p.size_guide) { %><a class="size-guide" href="/uploads/<%= p.size_guide %>" target="_blank" rel="noopener"><%= t('Guía de tallas') %></a><% } %>
    <select name="size<%= suffix %>" required>
      <option value=""><%= t('Elige…') %></option>
      <% sizes.forEach(s => { %><option><%= s %></option><% }) %>
    </select>
  </label>
<% } %>
<% if (p.personalization === 2) { %>
  <fieldset class="custom-choice" data-custom-choice>
    <legend><%= t('Personalización') %></legend>
    <label class="check"><input type="radio" name="no_custom<%= suffix %>" value="0" required> <%= t('Personalizar con nombre jugador y dorsal') %></label>
    <label class="check"><input type="radio" name="no_custom<%= suffix %>" value="1" required> <%= t('Sin personalizar') %></label>
  </fieldset>
<% } %>
<% if (p.personalization) { %>
  <div class="row"<% if (p.personalization === 2) { %> data-custom-fields hidden<% } %>>
    <label class="grow"><%= t('Nombre jugador') %> <input name="custom_name<%= suffix %>" maxlength="30" required></label>
    <label class="w-dorsal"><%= t('Dorsal') %> <input name="custom_number<%= suffix %>" inputmode="numeric" pattern="\d{1,3}" maxlength="3" required></label>
  </div>
<% } %>
