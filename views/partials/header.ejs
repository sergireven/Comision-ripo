<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? t(title) + ' · ' : '' %><%= t('Comisión de eventos') %> · <%= clubName %></title>
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" href="/static/img/escut.gif">
</head>
<% const isAdmin = user && user.role === 'admin';
   const isFamily = user && user.role === 'family';
   const on = (p) => path === p || path.startsWith(p + '/') ? 'active' : '';
   const shopPage = ['/tienda', '/carrito', '/pedidos'].some((p) => path.startsWith(p)) || (isAdmin && path.startsWith('/admin')); %>
<body class="<%= isAdmin ? 'is-admin' : '' %>">
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">
      <img src="/static/img/escut.gif" alt="" width="44" height="44" class="brand-logo">
      <span><strong><%= t('Comisión de eventos') %></strong><small><%= clubName %></small></span>
    </a>
    <div class="lang-switch" aria-label="<%= t('Idioma') %>">
      <a href="/idioma/ca" class="<%= lang === 'ca' ? 'active' : '' %>" hreflang="ca" lang="ca">CA</a>
      <a href="/idioma/es" class="<%= lang === 'es' ? 'active' : '' %>" hreflang="es" lang="es">ES</a>
    </div>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="<%= t('Menú') %>">
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('Inicio') %></a>
      <a href="/tienda" class="<%= on('/tienda') %>"><%= t('Tienda') %></a>
      <a href="/qui-som" class="<%= on('/qui-som') %>"><%= t('Quiénes somos') %></a>
      <% if (!user) { %>
        <a href="/login" class="nav-cta <%= on('/login') %>"><%= t('Entrar') %></a>
      <% } else { %>
        <span class="nav-sep" aria-hidden="true"></span>
        <% if (isFamily) { %>
          <a href="/carrito" class="<%= on('/carrito') %>"><%= t('Carrito') %><% if (cartCount) { %> <span class="pill"><%= cartCount %></span><% } %></a>
          <a href="/pedidos" class="<%= on('/pedidos') %>"><%= t('Mis pedidos') %></a>
          <a href="/cuenta" class="<%= on('/cuenta') %>"><%= t('Mi cuenta') %></a>
        <% } else { %>
          <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>"><%= t('Panel') %></a>
        <% } %>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike"><%= t('Salir') %></button></form>
      <% } %>
    </nav>
  </div>
</header>

<% if (isAdmin) { %>
<nav class="adminbar" aria-label="<%= t('Panel de la comisión') %>">
  <div class="wrap adminbar-inner">
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'active' : '' %>"><%= t('Panel') %></a>
    <a href="/admin/escanear" class="<%= path.startsWith('/admin/escanear') || path.startsWith('/admin/qr') ? 'active' : '' %>"><%= t('Escanear') %></a>
    <a href="/admin/pedidos" class="<%= on('/admin/pedidos') %>"><%= t('Pedidos') %></a>
    <a href="/admin/resumen" class="<%= on('/admin/resumen') %>"><%= t('Resumen') %></a>
    <a href="/admin/productos" class="<%= path.startsWith('/admin/productos') || path.startsWith('/admin/categorias') ? 'active' : '' %>"><%= t('Productos') %></a>
    <a href="/admin/periodos" class="<%= on('/admin/periodos') %>"><%= t('Periodos') %></a>
    <a href="/admin/familias" class="<%= on('/admin/familias') %>"><%= t('Familias') %></a>
    <a href="/admin/web" class="<%= on('/admin/web') %>"><%= t('Textos de la web') %></a>
    <a href="/cuenta" class="<%= on('/cuenta') %>"><%= t('Mi cuenta') %></a>
  </div>
</nav>
<% } %>

<% if (shopPage) { %>
<div class="shopbar <%= shop.open ? 'open' : 'closed' %>">
  <div class="wrap">
    <span class="dot"></span>
    <% if (shop.open) { %>
      <%= t('Pedidos abiertos') %><% if (shop.current.name) { %> · <strong><%= shop.current.name %></strong><% } %>.
      <%= t('Cierra el {date}', { date: formatDate(shop.current.ends_at) }) %> —
      <%= t('quedan') %> <strong data-countdown="<%= shop.current.ends_at %>" data-lang="<%= lang %>">…</strong>
    <% } else if (shop.next) { %>
      <%= t('Pedidos cerrados. Próxima apertura ({name}):', { name: shop.next.name }) %> <strong><%= formatDate(shop.next.starts_at) %></strong>
      — <%= t('en') %> <strong data-countdown="<%= shop.next.starts_at %>" data-lang="<%= lang %>">…</strong>
    <% } else { %>
      <%= t('Pedidos cerrados. La comisión avisará cuando se abra el próximo periodo.') %>
    <% } %>
  </div>
</div>
<% } %>

<main class="wrap">
<% if (flash) { %>
  <div class="flash <%= flash.type %>" role="status"><%= t(flash.text, flash.params) %></div>
<% } %>
