<%# Asistente «Pollet»: botón flotante y ventana de chat (solo si hay clave de la API configurada). %>
<div class="pollet" data-pollet data-csrf="<%= csrf %>" data-lang="<%= lang %>"
     data-error="<%= t('Ahora mismo no puedo responder. Vuelve a probar en un rato o pregunta a la comisión.') %>"
     data-limit="<%= t('Por hoy ya he respondido muchas preguntas. Vuelve mañana o pregunta a la comisión.') %>"
     data-refusal="<%= t('Eso no te lo puedo responder. Pregunta a la comisión, por favor.') %>"
     data-thinking="<%= t('Pensando…') %>">
  <button type="button" class="pollet-fab" data-pollet-open aria-label="<%= t('Pregunta a Pollet') %>" aria-expanded="false">
    <img src="/static/img/pollet.svg" alt="" width="44" height="44">
    <span class="pollet-fab-label"><%= t('¿Dudas?') %></span>
  </button>
  <section class="pollet-panel" data-pollet-panel hidden aria-label="<%= t('Pollet, el asistente de la tienda') %>">
    <header class="pollet-head">
      <img src="/static/img/pollet.svg" alt="" width="36" height="36">
      <div><strong>Pollet</strong><br><span class="small"><%= t('Asistente de la tienda') %></span></div>
      <button type="button" class="pollet-close" data-pollet-close aria-label="<%= t('Cerrar') %>">×</button>
    </header>
    <div class="pollet-log" data-pollet-log aria-live="polite">
      <div class="pollet-msg bot"><%= t('¡Hola! Soy Pollet. Pregúntame lo que quieras sobre la tienda: productos, tallas, packs, cómo pagar o tus pedidos.') %></div>
      <div class="pollet-chips" data-pollet-chips>
        <button type="button"><%= t('¿Cómo hago un pedido?') %></button>
        <button type="button"><%= t('¿Cómo funcionan los packs?') %></button>
        <button type="button"><%= t('¿Cuándo cierran los pedidos?') %></button>
        <% if (user && user.role === 'family') { %><button type="button"><%= t('¿Cómo está mi pedido?') %></button><% } %>
      </div>
    </div>
    <form class="pollet-form" data-pollet-form>
      <textarea rows="1" maxlength="600" placeholder="<%= t('Escribe tu pregunta…') %>" aria-label="<%= t('Tu pregunta') %>" required></textarea>
      <button class="btn primary" aria-label="<%= t('Enviar') %>">➤</button>
    </form>
    <p class="pollet-note"><%= t('Soy un asistente automático y me puedo equivocar. Para pagos y cambios, habla con la comisión.') %></p>
  </section>
</div>
<script src="/static/js/assistant.js?v=<%= assetVersion %>"></script>
