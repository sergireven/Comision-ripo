<%- include('../partials/header') %>
<p><a href="/pedidos">← Mis pedidos</a></p>
<div class="page-head">
  <h1>Pedido <%= orderCode(order.id) %></h1>
  <%- include('../partials/status', { status: order.status }) %>
</div>

<% if (order.status === 'pendiente_pago') { %>
  <div class="card highlight">
    <p>Importe a pagar en mano a la comisión: <strong class="big-amount"><%= formatMoney(order.total_cents) %></strong></p>
    <p class="muted small">Cuando la comisión registre el pago lo verás aquí y te llegará un correo.</p>
    <form method="post" action="/pedidos/<%= order.id %>/cancelar" data-confirm="¿Seguro que quieres cancelar este pedido?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn danger ghost">Cancelar pedido</button>
    </form>
  </div>
<% } else if (order.status === 'pendiente_entrega') { %>
  <div class="card qr-card center">
    <h2>Pagado ✔ · Para recoger</h2>
    <p>Enseña este QR a la comisión cuando recojas el pedido. Al escanearlo quedará marcado como entregado.</p>
    <img src="<%= qr %>" alt="Código QR de entrega" width="280" height="280">
    <p>Código de entrega: <span class="code"><%= order.delivery_code %></span></p>
    <p class="muted small">No compartas este código: solo sirve para recoger este pedido.</p>
  </div>
<% } else if (order.status === 'entregado') { %>
  <div class="card ok-card">Entregado el <%= formatDate(order.delivered_at) %>. ¡Gracias!</div>
<% } %>

<div class="card table-wrap">
  <table class="table stack">
    <thead><tr><th>Producto</th><th>Detalles</th><th>Cant.</th><th class="num">Importe</th></tr></thead>
    <tbody>
    <% items.forEach(it => { %>
      <tr>
        <td><%= it.product_name %><br><span class="muted small"><%= formatMoney(it.unit_price_cents) %>/u.</span></td>
        <td class="small" data-label="Detalles"><% if (it.size) { %>Talla <%= it.size %><br><% } %><% if (it.custom_name) { %>«<%= it.custom_name %>» · dorsal <%= it.custom_number %><% } %></td>
        <td data-label="Cantidad"><%= it.quantity %></td>
        <td class="num" data-label="Importe"><%= formatMoney(it.unit_price_cents * it.quantity) %></td>
      </tr>
    <% }) %>
    </tbody>
    <tfoot><tr><th colspan="3">Total</th><th class="num"><%= formatMoney(order.total_cents) %></th></tr></tfoot>
  </table>
</div>

<div class="card">
  <h2>Historial</h2>
  <ul class="timeline">
    <% events.forEach(e => { %>
      <li><span class="muted small"><%= formatDate(e.created_at) %></span> <%- include('../partials/status', { status: e.status }) %></li>
    <% }) %>
  </ul>
</div>
<%- include('../partials/footer') %>
