<%- include('../partials/header') %>
<h1><%= t('Mis pedidos') %></h1>
<% if (pending) { %>
  <div class="card highlight"><%= t('Tienes {amount} pendientes de pagar a la comisión.', { amount: formatMoney(pending) }) %></div>
<% } %>
<% if (!list.length) { %>
  <div class="card center"><p><%= t('Aún no has hecho ningún pedido.') %></p><a class="btn primary" href="/tienda"><%= t('Ir a la tienda') %></a></div>
<% } else { %>
  <div class="order-list">
  <% list.forEach(o => { %>
    <a class="card order-row" href="/pedidos/<%= o.id %>">
      <div><strong><%= t('Pedido {code}', { code: orderCode(o.id) }) %></strong><br><span class="muted small"><%= formatDate(o.created_at) %> · <%= t('{n} artículo(s)', { n: o.units }) %></span>
        <% if (o.status === 'pendiente_entrega' && o.ready_at) { %><br><span class="badge ok"><%= t('¡Listo para recoger!') %></span><% } %></div>
      <div class="right"><%- include('../partials/status', { status: o.status }) %><br><strong><%= formatMoney(o.total_cents) %></strong></div>
    </a>
  <% }) %>
  </div>
<% } %>
<%- include('../partials/footer') %>
