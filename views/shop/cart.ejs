<%- include('../partials/header') %>
<h1><%= t('Carrito') %></h1>
<% if (!cart.items.length) { %>
  <div class="card center">
    <p><%= t('Tu carrito está vacío.') %></p>
    <a class="btn primary" href="/tienda"><%= t('Ir a la tienda') %></a>
  </div>
<% } else { %>
  <div class="card table-wrap">
    <table class="table stack">
      <thead><tr><th><%= t('Producto') %></th><th><%= t('Detalles') %></th><th><%= t('Precio') %></th><th><%= t('Cantidad') %></th><th class="num"><%= t('Importe') %></th><th></th></tr></thead>
      <tbody>
      <% cart.items.forEach(it => { %>
        <tr class="<%= it.active ? '' : 'unavailable' %>">
          <td><strong><%= loc(it, 'product_name') %></strong>
            <% if (!it.active) { %><br><span class="badge muted"><%= t('No disponible') %></span><% } %>
            <% if (it.inPack) { %><br><span class="badge info"><%= it.inPack === it.quantity ? t('En pack') : t('{n} en pack', { n: it.inPack }) %></span><% } %></td>
          <td class="small" data-label="<%= t('Detalles') %>"><%- include('../partials/items', { it }) %></td>
          <td data-label="<%= t('Precio') %>"><%= formatMoney(it.price_cents) %></td>
          <td data-label="<%= t('Cantidad') %>">
            <form method="post" action="/carrito/<%= it.id %>/cantidad" class="row tight">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="number" name="quantity" value="<%= it.quantity %>" min="1" max="50" class="qty" aria-label="<%= t('Cantidad') %>">
              <button class="btn small">OK</button>
            </form>
          </td>
          <td class="num" data-label="<%= t('Importe') %>"><%= formatMoney(it.price_cents * it.quantity) %></td>
          <td>
            <form method="post" action="/carrito/<%= it.id %>/eliminar">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn small danger ghost"><%= t('Quitar') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

  <% if (cart.applied.length) { %>
  <section class="card packs-applied">
    <h2>🎉 <%= t('Packs aplicados') %></h2>
    <% cart.applied.forEach(a => { %>
      <div class="applied">
        <div class="applied-head">
          <strong><%= loc(a.pack, 'name') %></strong>
          <span><s class="muted"><%= formatMoney(a.regular) %></s> <strong><%= formatMoney(a.pack.price_cents) %></strong> <span class="badge ok">−<%= formatMoney(a.saving) %></span></span>
        </div>
        <ul class="small">
          <% a.units.forEach(u => { %><li><%= loc(u, 'product_name') %><% const d = [u.color, u.option_value, u.size && t('Talla') + ' ' + u.size, u.custom_name && '«' + u.custom_name + '» ' + u.custom_number].filter(Boolean); if (d.length) { %> <span class="muted">(<%= d.join(' · ') %>)</span><% } %></li><% }) %>
          <% a.gifts.forEach(g => { %><li class="gift">🎁 <%= loc(g, 'name') %> <span class="badge ok"><%= t('de regalo') %></span></li><% }) %>
        </ul>
      </div>
    <% }) %>
  </section>
  <% } else { %>
    <p class="muted small"><%= t('Si añades los artículos de un pack, el descuento se aplica solo.') %> <a href="/tienda?categoria=packs"><%= t('Ver packs') %></a></p>
  <% } %>

  <div class="card totals">
    <% if (cart.discount) { %>
      <div class="total-row"><span><%= t('Subtotal') %></span><span><%= formatMoney(cart.subtotal) %></span></div>
      <div class="total-row discount"><span><%= t('Descuento packs') %></span><span>−<%= formatMoney(cart.discount) %></span></div>
    <% } %>
    <div class="total-row grand"><span><%= t('Total') %></span><span><%= formatMoney(cart.total) %></span></div>
  </div>

  <div class="card checkout">
    <div>
      <p><strong><%= t('Revisa que todo sea correcto (colores, tallas, nombre y número) antes de confirmar.') %></strong></p>
      <p class="muted small"><%= t('El pago se hace en mano a la comisión. Hasta que no esté pagado podrás cancelar el pedido.') %></p>
    </div>
    <form method="post" action="/carrito/confirmar" data-confirm="<%= t('¿Confirmas el pedido por {amount}?', { amount: formatMoney(cart.total) }) %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn primary big" <%= shop.open ? '' : 'disabled' %>><%= t('Realizar pedido') %> · <%= formatMoney(cart.total) %></button>
      <% if (!shop.open) { %><p class="small error-text"><%= t('El periodo de pedidos está cerrado.') %></p><% } %>
    </form>
  </div>
<% } %>
<%- include('../partials/footer') %>
