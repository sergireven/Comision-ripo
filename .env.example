# Puerto y URL pública (se usa en los correos y en los QR de entrega)
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=production

# Secreto largo y aleatorio para firmar la sesión (obligatorio en producción)
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
# true si se sirve por HTTPS (recomendado). TRUST_PROXY=1 si va detrás de un proxy/hosting.
COOKIE_SECURE=false
TRUST_PROXY=

CLUB_NAME=Club Hoquei Ripollet

# Primer administrador: se crea al arrancar si todavía no existe (útil en hostings sin consola).
# Una vez creado, cambiar esta variable no modifica su contraseña.
ADMIN_USER=comision
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Idioma por defecto si el navegador no indica catalán ni castellano (ca | es)
DEFAULT_LANG=ca
# Idioma de los avisos que recibe la comisión (ADMIN_NOTIFY_EMAIL)
ADMIN_LANG=ca

# Rutas de datos (opcional)
# DB_PATH=./data/club.db
# UPLOAD_DIR=./uploads

# Correo (SMTP). Si SMTP_HOST está vacío, los correos NO se envían: se guardan en Admin > Correos.
# Ejemplo Gmail: smtp.gmail.com, puerto 465, SMTP_SECURE=true y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Club Hoquei Ripollet <botiga@example.com>
# Correo de la comisión: recibe aviso de cada pedido nuevo o cancelado
ADMIN_NOTIFY_EMAIL=
